# Copy to ~/.dbt/profiles.yml (or farm_analytics/profiles.yml, which is gitignored).
# All secrets come from environment variables -- nothing sensitive is committed.
farm_analytics:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'TRANSFORMER') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'FARM_WH') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE', 'FARM_OPS') }}"
      schema: DBT_DEV          # dev builds land in DBT_DEV_STAGING / _CORE / _KPI
      threads: 4
    prod:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'TRANSFORMER') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'FARM_WH') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE', 'FARM_OPS') }}"
      schema: ANALYTICS        # prod builds land in STAGING / CORE / KPI
      threads: 4
