# --- PostgreSQL (source) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farm_ops
DB_USER=
DB_PASSWORD=

# --- Snowflake (warehouse) ---
# Account identifier, e.g. abc12345.us-west-2 or ORGNAME-ACCOUNTNAME
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=DBT_USER
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/snowflake_key.p8
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=FARM_WH
SNOWFLAKE_DATABASE=FARM_OPS
